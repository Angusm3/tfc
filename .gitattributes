# Line endings: LF for text we author, never touch binaries.
* text=auto
*.yaml eol=lf
*.ftl eol=lf
*.lua eol=lf
*.cs eol=lf
*.csproj eol=lf
*.sln eol=lf
*.sh eol=lf
mod.config eol=lf

*.png binary
*.shp binary
*.oramap binary
*.dll binary
*.wav binary
*.aud binary
*.vqa binary
*.mix binary

# Custom for Visual Studio
*.cs     diff=csharp
