# Names and descriptions of the Forgotten (tfa) actors, ported from legacy-0.32/factions/tfa/rules/army.yaml.
# Strings the 0.32 file wrote as raw text. Husk names are from legacy-0.32/rules/husks.yaml.
actor-huey =
    .name = UH-1 Huey
    .description =
    Transport helicopter modified to a gunship. Carries Twin Missile launchers.
      Strong vs Infantry, Light Vehicles
      Weak vs Tanks

actor-militia =
    .name = Militia
    .description =
    Rifle soldier,
      Carries Semi Automatic Rifle

actor-smaw =
    .name = SMAW Launcher
    .description =
    Anti-tank infantry.
      Strong vs Tanks
      Weak vs Infantry

actor-mltvinf =
    .name = Molotov Soldiers
    .description =
    Militia armed with molotov cocktails.
      Strong vs Buildings, Infantry
      Weak vs Vehicles

actor-mrtr =
    .name = Forgotten Mortar
    .description =
    Long Range artillery infantry.
      Strong vs Ground
      Weak vs Air

actor-sniper =
    .name = Scout
    .description =
    Elite Scout,
      Carries Bolt Action Rifle

actor-sniperd =
    .name = Scout (Prone)

actor-cmbt =
    .name = Combat Engineer
    .description =
    Combat Engineer,
      Wields Dual 50. Caliber pistols
      Captures buildings

actor-hjkr =
    .name = Hijacker
    .description =
    Infiltrates and captures enemy vehicles.
      Strong vs Nothing
      Weak vs Everything

actor-fmcv =
    .name = Mobile Construction Vehicle
    .description =
    Deploys into another Construction Yard.
      Unarmed

actor-fharv =
    .name = Harvester
    .description =
    Collects Tiberium for processing.
      Unarmed

actor-ftch =
    .name = Technical
    .description =
    Lightweight Scout Truck
      Strong vs Infantry, Air
      Weak vs Everything else

actor-fhtnk =
    .name = Heavy Tank
    .description =
    Heavy Duty Forgotten Tank.
      Strong vs Tanks, Vehicles
      Weak vs Infantry, Aircraft

actor-bdzr =
    .name = WarDozer
    .description =
    Extremely Heavy Armour bolted in
      Fires Two Anti-Material 50. Cal Machine Guns independently
      Strong vs Infantry, Light Vehicles
      Weak vs Tanks, Artillery

actor-slar =
    .name = Solar Array
    .description =
    Generates power

actor-aslr =
    .name = Solar Array
    .description =
    Generates power

actor-rfnry =
    .name = Tiberium Refinery
    .description =
    Processes raw Tiberium
      into useable resources

actor-tent =
    .name = Tent Barracks
    .description =
    Trains infantry

actor-fsal =
    .name = Forgotten Salvage
    .description =
    Assembly point for
      vehicle reinforcements
      repairs allied vehicles near it

actor-mgnst =
    .name = Machine Gun Nest
    .description =
    Anti-Infantry base Defence.
      Strong vs Infantry
      Weak vs Tanks

actor-fhpd =
    .name = Slab of Concrete
    .description =
    Produces and
      repairs helicopters

actor-rdst =
    .name = Radio Station
    .description =
    Provides an overview of the battlefield.
      Requires power to operate.
    .airstrikepower-name = Air Strike
    .airstrikepower-description =
    Deploy an aerial napalm strike.
      Burns buildings and infantry along a line.

actor-tsla =
    .name = Tesla Coil
    .description =
    Advanced base Defence. Requires power
      to operate.
      Strong vs Tanks, Infantry
      Weak vs Aircraft

actor-grnh =
    .name = Tiberium Greenhouse
    .description =
    Tiberium festers within
      Very Little Power Required.
    .nukepower-name = RTM Strike
    .nukepower-description =
    Launch a Red Tiberium Missile.
      Applies heavy damage over a large area.

actor-fsam =
    .name = SAM Site
    .description =
    Anti-Air base Defence.
      Strong vs Aircraft
      Weak vs Infantry, Tanks

actor-sporetree =
    .name = Tib farm
    .description =
    provides tiberium

actor-tfsr =
    .name = Tiberium Fissure
    .description =
    Opens a rift in the ground that tiberium seeps out of,
      altering the terrain

actor-foxhole =
    .name = Pillbox

actor-ftch-husk-name = Forgotten Technical (Destroyed)
actor-fhtnk-husk-name = Heavy Tank (Destroyed)
actor-bdzr-husk-name = Forgotten WarDozer (Destroyed)
